{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "outDir": "packages/build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": ["node"],
    "paths": {
      "@julia/core": ["./packages/core/index.ts"],
      "@julia/core/*": ["./packages/core/*"]
    }
  },
  "include": ["src/**/*.ts", "packages/core/**/*.ts"]
}
