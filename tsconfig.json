{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "outDir": "app/build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": ["node"],

    "paths": {
      "@julia/core": ["./app/core/index.ts"],
      "@julia/core/*": ["./app/core/*"]
    }
  },
  "include": ["src/**/*.ts", "app/core/**/*.ts"]
}
