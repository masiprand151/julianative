{
  "name": "julianative",
  "version": "1.0.0",
  "description": "TypeScript to native C++ desktop compiler",
  "private": true,
  "bin": {
    "julia": "scripts/cli.js"
  },
  "scripts": {
    "build:ts": "tsc && tsc-alias -p tsconfig.json",
    "check:ts": "tsc --noEmit",
    "test": "npm run build:ts && node --test tests/components.test.cjs tests/navigation.test.cjs tests/renderer.test.cjs tests/localStorage.test.cjs tests/state.test.cjs",
    "configure:app": "cmake -S . -B packages/build -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_COMPILER=C:/msys64/ucrt64/bin/gcc.exe -DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe",
    "build:app": "npm run build:ts && npm run configure:app && cmake --build packages/build",
    "app": "npm run build:app && bash -lc './packages/build/JuliaNative.exe'",
    "dev": "npm run build:app && node scripts/dev.cjs",
    "dev:reload": "node scripts/cli.js dev:reload",
    "prepare:portable": "node scripts/prepare-portable.cjs",
    "portable": "npm run build:app && npm run prepare:portable"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masiprand151/julianative.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/masiprand151/julianative/issues"
  },
  "homepage": "https://github.com/masiprand151/julianative#readme",
  "dependencies": {
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.14",
    "tsc-alias": "^1.9.10"
  }
}
