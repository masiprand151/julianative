{
  "name": "julianative",
  "version": "0.1.0",
  "description": "TypeScript to native C++ desktop compiler",
  "private": true,
  "scripts": {
    "build:ts": "tsc",
    "check:ts": "tsc --noEmit",
    "configure:app": "cmake -S . -B app/build -G Ninja -DCMAKE_BUILD_TYPE=Debug -DCMAKE_C_COMPILER=C:/msys64/ucrt64/bin/gcc.exe -DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe",
    "build:app": "npm run configure:app && cmake --build app/build",
    "app": "npm run build:app && bash -lc './app/build/JuliaNative.exe'",
    "dev": "nodemon",
    "dev:restart": "npm run build:ts && npm run app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masiprand151/julianative.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/masiprand151/julianative/issues"
  },
  "homepage": "https://github.com/masiprand151/julianative#readme",
  "dependencies": {
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14"
  }
}
